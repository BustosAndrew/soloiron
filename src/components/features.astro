---
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "AI-Powered Products",
    description:
      "I take AI features from prototype to production — an internal transcript editor that turns audio around in 1–2 minutes, and real-time translation holding 96% accuracy across 70+ languages at sub-2-second latency.",
    icon: "uil:robot",
  },
  {
    title: "Revenue-Ready Web Apps",
    description:
      "Next.js, TypeScript and Postgres apps built to take money on day one: Stripe checkout, i18n, auth and SMS notifications — the stack behind ecommerce and booking sites doing thousands in online sales.",
    icon: "uil:rocket",
  },
  {
    title: "Automation & Internal Tools",
    description:
      "Playwright scrapers, REST APIs and custom dashboards that delete manual work — 40 hours a week of admin overhead removed, and bulk updates cut from minutes to under 30 seconds.",
    icon: "uil:processor",
  },
];
---

<section id="services" class="scroll-mt-24 py-16 md:py-24">
  <div class="reveal max-w-3xl">
    <span
      class="text-sm font-semibold uppercase tracking-widest text-brand-600 dark:text-brand-400">
      Services
    </span>
    <h2
      class="mt-3 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl lg:text-5xl lg:tracking-tight dark:text-white">
      What kind of work do I do?
    </h2>
    <p class="mt-4 text-lg leading-relaxed text-stone-600 dark:text-stone-400">
      I work the way a small team needs someone to work — across the whole
      stack, shipping features that reach real users instead of staying in a
      branch. Most of what I build falls into three buckets.
    </p>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((item, i) => (
        <article
          class="card-hover reveal group relative overflow-hidden rounded-2xl border border-stone-200 bg-white p-7 shadow-sm hover:border-brand-300 hover:shadow-2xl hover:shadow-brand-500/10 dark:border-stone-800 dark:bg-stone-900/60 dark:hover:border-brand-700 dark:hover:shadow-brand-500/5"
          style={`--reveal-delay:${i * 110}ms`}>
          {/* Gradient wash that fades in on hover */}
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-50 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 dark:from-brand-950/40"
            aria-hidden="true"
          />

          <div class="relative">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-stone-900 shadow-lg shadow-stone-900/20 transition-transform duration-500 group-hover:-rotate-6 group-hover:scale-110 dark:bg-white dark:shadow-black/40">
              <Icon
                class="h-6 w-6 text-white dark:text-stone-900"
                name={item.icon}
              />
            </div>

            <h3 class="mt-5 text-lg font-semibold text-stone-900 dark:text-white">
              {item.title}
            </h3>
            <p class="mt-2 leading-relaxed text-stone-600 dark:text-stone-400">
              {item.description}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>
