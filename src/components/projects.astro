---
import { Tick } from "@components/ui/icons";
import Link from "@components/ui/link.astro";

interface Plan {
  name: string;
  tech: string;
  features: string[];
  button: { text: string; link: string };
  /* The old `popular` flag is no longer read — it only ever encoded index
     parity, which is now derived directly. Leaving it on a project object is
     harmless and it can be deleted from the data whenever convenient. */
  popular?: boolean;
}

interface Props {
  plan: Plan;
  index?: number;
}

const { plan, index = 0 } = Astro.props;

/**
 * Cards alternate between two accents drawn from the site palette — rose, then
 * amber — so a long grid reads as a rhythm instead of one flat block. On the
 * 3-column layout the odd column count offsets each row, which turns the
 * two-colour cycle into a diagonal weave rather than hard stripes.
 *
 * Class strings are written out in full (no interpolation) so Tailwind's
 * scanner can see them.
 */
const accents = [
  {
    bar: "from-brand-500 to-brand-300",
    border: "hover:border-brand-300 dark:hover:border-brand-700",
    shadow: "hover:shadow-brand-500/15 dark:hover:shadow-brand-500/10",
    wash: "from-brand-50/80 dark:from-brand-950/30",
    title: "group-hover:text-brand-600 dark:group-hover:text-brand-400",
    tick: "text-brand-600 dark:text-brand-400",
    chip: "bg-brand-50 text-brand-700 dark:bg-brand-950/50 dark:text-brand-300",
  },
  {
    bar: "from-amber-500 to-amber-300",
    border: "hover:border-amber-300 dark:hover:border-amber-700",
    shadow: "hover:shadow-amber-500/15 dark:hover:shadow-amber-500/10",
    wash: "from-amber-50/80 dark:from-amber-950/30",
    title: "group-hover:text-amber-600 dark:group-hover:text-amber-400",
    tick: "text-amber-600 dark:text-amber-400",
    chip: "bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300",
  },
];

const accent = accents[index % accents.length];

// Fill and outline buttons ride the same cycle, so the CTA can never disagree
// with the card it sits in.
const buttonStyle = index % 2 === 1 ? "primary" : "outline";

// "Tech" arrives as a comma-separated string; split it into chips.
const techChips = plan.tech
  .split(",")
  .map((t) => t.trim())
  .filter(Boolean);

const isExternal = /^https?:\/\//.test(plan.button.link ?? "");
---

<article
  class="reveal group h-full"
  style={`--reveal-delay:${Math.min(index, 8) * 90}ms`}>
  <div
    class:list={[
      "card-hover relative flex h-full flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white p-6 shadow-sm hover:shadow-2xl dark:border-stone-800 dark:bg-stone-900/60",
      accent.border,
      accent.shadow,
    ]}>
    <!-- Accent bar that sweeps in on hover -->
    <div
      class:list={[
        "absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gradient-to-r transition-transform duration-500 group-hover:scale-x-100",
        accent.bar,
      ]}
      aria-hidden="true">
    </div>

    <!-- Tinted wash that fades up from the card corner on hover -->
    <div
      class:list={[
        "pointer-events-none absolute inset-0 bg-gradient-to-br via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100",
        accent.wash,
      ]}
      aria-hidden="true">
    </div>

    <header class="relative">
      <h3
        class:list={[
          "text-2xl font-bold tracking-tight text-stone-900 transition-colors dark:text-white",
          accent.title,
        ]}>
        {plan.name}
      </h3>

      <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tech stack">
        {
          techChips.map((tech) => (
            <li
              class:list={[
                "rounded-md px-2 py-0.5 text-xs font-medium transition-colors duration-500",
                accent.chip,
              ]}>
              {tech}
            </li>
          ))
        }
      </ul>
    </header>

    <ul class="relative mt-6 grid gap-y-3 text-left">
      {
        plan.features.map((item: string) => (
          <li class="flex items-start gap-3 text-stone-700 dark:text-stone-300">
            <Tick class={`mt-0.5 h-5 w-5 shrink-0 ${accent.tick}`} />
            <span class="text-sm leading-relaxed">{item}</span>
          </li>
        ))
      }
    </ul>

    <!-- mt-auto keeps every CTA aligned along the bottom of the row -->
    <div class="relative mt-auto flex pt-8">
      <Link
        href={plan.button.link || "#"}
        block
        size="md"
        style={buttonStyle}
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener noreferrer" : undefined}>
        {plan.button.text || "Get Started"}
      </Link>
    </div>
  </div>
</article>
