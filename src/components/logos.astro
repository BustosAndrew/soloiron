---
import { Icon } from "astro-icon/components";

const technologies = [
  { name: "React", icon: "simple-icons:react" },
  { name: "Next.js", icon: "akar-icons:nextjs-fill" },
  { name: "TypeScript", icon: "simple-icons:typescript" },
  { name: "Tailwind CSS", icon: "simple-icons:tailwindcss" },
  { name: "Electron", icon: "simple-icons:electron" },
  { name: "Node.js", icon: "la:node" },
  { name: "Python", icon: "simple-icons:python" },
  { name: "FastAPI", icon: "simple-icons:fastapi" },
  { name: "PostgreSQL", icon: "simple-icons:postgresql" },
  { name: "Supabase", icon: "simple-icons:supabase" },
  { name: "Playwright", icon: "simple-icons:playwright" },
  { name: "AWS", icon: "simple-icons:amazonwebservices" },
];
---

<section class="py-16 md:py-20">
  <div class="reveal text-center">
    <h2
      class="text-2xl font-semibold tracking-tight text-stone-900 sm:text-3xl dark:text-white">
      Technologies I use
    </h2>
    <p class="mt-3 text-stone-600 dark:text-stone-400">
      The stack I reach for when building production software — plus React
      Native for mobile and Claude Code as a force multiplier.
    </p>
  </div>

  <ul
    class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 md:gap-4 lg:grid-cols-6">
    {
      technologies.map((tech, i) => (
        <li
          class="reveal"
          style={`--reveal-delay:${Math.min(i, 11) * 45}ms`}>
          <div class="card-hover group flex h-full flex-col items-center justify-center gap-3 rounded-2xl border border-stone-200 bg-white px-3 py-6 shadow-sm hover:border-brand-300 hover:shadow-xl hover:shadow-brand-500/10 dark:border-stone-800 dark:bg-stone-900/60 dark:hover:border-brand-700 dark:hover:shadow-brand-500/5">
            <Icon
              class="h-9 w-9 text-stone-700 transition-all duration-500 group-hover:scale-110 group-hover:text-brand-600 dark:text-stone-300 dark:group-hover:text-brand-400"
              name={tech.icon}
            />
            <span class="text-center text-sm font-medium text-stone-600 dark:text-stone-400">
              {tech.name}
            </span>
          </div>
        </li>
      ))
    }
  </ul>
</section>
