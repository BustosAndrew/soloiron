---
import Container from "@components/container.astro";
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();

const navLinks = [
  { title: "Projects", path: "/projects" },
  { title: "About", path: "/about" },
  { title: "Contact", path: "/contact" },
];

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/BustosAndrew",
    icon: "bx:bxl-github",
  },
];
---

<footer
  class="mt-auto border-t border-stone-200 bg-stone-50/60 dark:border-stone-800 dark:bg-stone-900/40">
  <Container>
    <div class="grid gap-10 py-14 md:grid-cols-3">
      <div class="md:col-span-1">
        <a
          href="/"
          class="group inline-flex items-center gap-2.5"
          aria-label="Andrew Bustos — home">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-stone-900 text-sm font-bold text-white shadow-md shadow-stone-900/20 transition-transform duration-300 group-hover:-rotate-6 dark:bg-white dark:text-stone-900">
            AB
          </span>
          <span class="font-bold text-stone-900 dark:text-white">
            Andrew Bustos
          </span>
        </a>
        <p
          class="mt-4 max-w-xs text-sm leading-relaxed text-stone-600 dark:text-stone-400">
          Fullstack engineer shipping AI-powered products, Next.js web apps and
          the automation tooling that removes manual work.
        </p>
        <p
          class="mt-4 flex items-center gap-2 text-sm text-stone-500 dark:text-stone-500">
          <Icon class="h-4 w-4" name="uil:map-marker" aria-hidden="true" />
          Santa Clara, CA
        </p>
      </div>

      <nav aria-label="Footer">
        <h2
          class="text-sm font-semibold uppercase tracking-widest text-stone-900 dark:text-white">
          Navigate
        </h2>
        <ul class="mt-4 space-y-2.5">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.path}
                  class="text-sm text-stone-600 transition-colors hover:text-brand-600 dark:text-stone-400 dark:hover:text-brand-400">
                  {link.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2
          class="text-sm font-semibold uppercase tracking-widest text-stone-900 dark:text-white">
          Elsewhere
        </h2>
        <ul class="mt-4 flex gap-3">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-stone-600 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-600 hover:shadow-lg dark:border-stone-800 dark:bg-stone-900 dark:text-stone-400 dark:hover:border-brand-700 dark:hover:text-brand-400">
                  <Icon class="h-5 w-5" name={social.icon} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href="/contact"
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-stone-900 transition-colors hover:text-brand-600 dark:text-white dark:hover:text-brand-400">
          Start a project
          <span aria-hidden="true" class="transition-transform duration-300"
            >&rarr;</span
          >
        </a>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-3 border-t border-stone-200 py-6 sm:flex-row dark:border-stone-800">
      <p class="text-sm text-stone-500 dark:text-stone-500">
        &copy; {year} Andrew Bustos. All rights reserved.
      </p>
      <!--
        Can we ask you a favor 🙏
        Please keep this backlink on your website if possible.
        or Purchase a commercial license from https://web3templates.com
      -->
      <p class="text-xs text-stone-500 dark:text-stone-500">
        Built with <a
          href="https://astro.build"
          target="_blank"
          rel="noopener"
          class="underline-offset-2 hover:text-stone-900 hover:underline dark:hover:text-white"
          >Astro</a
        > &middot; <a
          href="https://web3templates.com"
          target="_blank"
          rel="noopener"
          class="underline-offset-2 hover:text-stone-900 hover:underline dark:hover:text-white"
          >Astroship</a
        >
      </p>
    </div>
  </Container>
</footer>
