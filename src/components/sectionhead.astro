---
interface Props {
  align?: "center" | "left";
  eyebrow?: string;
}

const { align = "center", eyebrow } = Astro.props;
---

<div
  class:list={[
    "relative pt-12 md:pt-16",
    align === "center" && "text-center",
  ]}>
  <!-- Soft glow behind the heading -->
  <div
    class="glow-blob pointer-events-none absolute left-1/2 top-0 -z-10 h-40 w-[28rem] max-w-full -translate-x-1/2 rounded-full bg-brand-300/25 dark:bg-brand-600/15"
    aria-hidden="true">
  </div>

  {
    eyebrow && (
      <span class="animate-fade-up text-sm font-semibold uppercase tracking-widest text-brand-600 dark:text-brand-400">
        {eyebrow}
      </span>
    )
  }

  <h1
    class="mt-3 animate-fade-up text-4xl font-bold tracking-tight text-stone-900 lg:text-5xl lg:tracking-tight dark:text-white">
    <slot name="title">Title</slot>
  </h1>

  <p
    class:list={[
      "mt-4 animate-fade-up text-lg leading-relaxed text-stone-600 [animation-delay:100ms] dark:text-stone-400",
      align === "center" && "mx-auto max-w-2xl",
    ]}>
    <slot name="desc">Some description goes here</slot>
  </p>
</div>
