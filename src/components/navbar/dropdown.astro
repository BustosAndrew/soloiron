---
import { Dropdown, DropdownItems } from "astro-navbar";

interface Props {
  title: string;
  lastItem?: boolean;
  children: { title: string; path: string }[];
}

const { title, lastItem, children } = Astro.props;
---

<li class="relative">
  <Dropdown class="group">
    <button
      class="flex w-full items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-stone-600 transition-colors hover:text-stone-900 lg:w-auto dark:text-stone-400 dark:hover:text-white">
      <span>{title}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="3"
        stroke="currentColor"
        aria-hidden="true"
        class="mt-0.5 h-3 w-3 transition-transform duration-300 group-open:rotate-180">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </button>
    <DropdownItems>
      <div
        class:list={[
          "z-10 w-full lg:absolute lg:w-52",
          lastItem ? "origin-top-right lg:right-0" : "origin-top-left lg:left-0",
        ]}>
        <div
          class="flex animate-fade-up flex-col px-3 lg:rounded-xl lg:border lg:border-stone-200 lg:bg-white lg:p-2 lg:shadow-xl lg:shadow-stone-900/10 dark:lg:border-stone-800 dark:lg:bg-stone-900 dark:lg:shadow-black/40">
          {
            children.map((item) => (
              <a
                href={item.path}
                class="rounded-lg px-2 py-1.5 text-sm text-stone-600 transition-colors hover:bg-stone-100 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-white">
                {item.title}
              </a>
            ))
          }
        </div>
      </div>
    </DropdownItems>
  </Dropdown>
</li>
