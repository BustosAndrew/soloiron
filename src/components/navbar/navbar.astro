---
import Container from "@components/container.astro";
import Link from "@components/ui/link.astro";
import ThemeToggle from "@components/ui/themetoggle.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Projects",
    path: "/projects",
  },
  {
    title: "About",
    path: "/about",
  },
  {
    title: "Contact",
    path: "/contact",
  },
];

// Trailing slashes are normalised so `/about` and `/about/` both light up.
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (path: string) => current === path.replace(/\/+$/, "");
---

<header
  class="sticky top-0 z-50 border-b border-transparent bg-surface/80 backdrop-blur-lg transition-[border-color,box-shadow,background-color] duration-300 data-[scrolled]:border-stone-200/80 data-[scrolled]:shadow-[0_1px_20px_-8px_rgb(68_36_32/0.30)] dark:bg-surface-dark/80 dark:data-[scrolled]:border-stone-800/80 dark:data-[scrolled]:shadow-[0_1px_24px_-8px_rgb(0_0_0/0.7)]"
  id="site-header">
  <Container>
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
      <Astronav>
        <div class="flex w-full items-center justify-between py-4 lg:w-auto">
          <a
            href="/"
            class="group flex items-center gap-2.5 text-lg"
            aria-label="Andrew Bustos — home">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-stone-900 text-sm font-bold text-white shadow-md shadow-stone-900/20 transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-105 dark:bg-white dark:text-stone-900 dark:shadow-black/40">
              AB
            </span>
            <span
              class="font-bold text-stone-900 transition-colors group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400">
              Andrew Bustos
            </span>
          </a>

          <div class="flex items-center gap-2 lg:hidden">
            <ThemeToggle />
            <MenuIcon
              class="h-9 w-9 rounded-lg border border-stone-200 p-2 text-stone-700 transition-colors hover:bg-stone-100 dark:border-stone-800 dark:text-stone-300 dark:hover:bg-stone-900"
            />
          </div>
        </div>

        <MenuItems class="hidden w-full lg:flex lg:w-auto">
          <ul
            class="flex animate-fade-up flex-col gap-1 pb-4 lg:animate-none lg:flex-row lg:items-center lg:gap-1 lg:pb-0">
            {
              menuitems.map((item) => (
                <li>
                  <a
                    href={item.path}
                    aria-current={isActive(item.path) ? "page" : undefined}
                    class:list={[
                      "relative flex rounded-lg px-3 py-2 text-sm font-medium transition-colors duration-200",
                      "after:absolute after:bottom-1 after:left-3 after:right-3 after:h-px after:origin-left after:scale-x-0 after:bg-brand-500 after:transition-transform after:duration-300 hover:after:scale-x-100",
                      isActive(item.path)
                        ? "text-stone-900 after:scale-x-100 dark:text-white"
                        : "text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-white",
                    ]}>
                    {item.title}
                  </a>
                </li>
              ))
            }
            <li class="mt-2 lg:hidden">
              <Link href="/contact" size="md" block>Let's work together</Link>
            </li>
          </ul>
        </MenuItems>
      </Astronav>

      <div class="hidden items-center gap-3 lg:flex">
        <ThemeToggle />
        <Link href="/contact" size="md" class="shadow-lg shadow-stone-900/10">
          Hire me
        </Link>
      </div>
    </div>
  </Container>
</header>

<script>
  // --- Theme toggle -------------------------------------------------------
  // The theme itself is applied pre-paint by the inline script in Layout.astro;
  // this only handles user-initiated flips.
  const root = document.documentElement;

  const setTheme = (theme: "light" | "dark") => {
    root.classList.toggle("dark", theme === "dark");
    try {
      localStorage.setItem("theme", theme);
    } catch {
      /* storage blocked — the toggle still works for this page view */
    }
  };

  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      setTheme(root.classList.contains("dark") ? "light" : "dark");
    });
  });

  // Follow the OS only while the user hasn't made an explicit choice.
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (e) => {
      try {
        if (localStorage.getItem("theme")) return;
      } catch {
        /* ignore */
      }
      root.classList.toggle("dark", e.matches);
    });

  // --- Header elevation on scroll ----------------------------------------
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 8) header.setAttribute("data-scrolled", "");
      else header.removeAttribute("data-scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
