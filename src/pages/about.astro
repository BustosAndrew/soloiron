---
import { Image } from "astro:assets";
import heroImage from "../assets/profile.jpeg";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";

const facts = [
  {
    icon: "uil:map-marker",
    label: "Based in",
    value: "Santa Clara, CA",
  },
  {
    icon: "uil:rocket",
    label: "Currently",
    value: "Fullstack Engineer, Interpret AI",
  },
  {
    icon: "uil:graduation-cap",
    label: "Education",
    value: "BS Computer Science, CSU East Bay",
  },
];

const timeline = [
  {
    role: "Fullstack Engineer",
    org: "Interpret AI",
    place: "San Jose, CA",
    period: "Jan 2024 — Present",
    points: [
      "Built an AI-powered internal transcript editor that turns audio uploads around in 1–2 minutes, helping unlock an $805,000 state contract.",
      "Shipped real-time translation and transcription on web and mobile with React and React Native — 96% accuracy across 70+ languages at sub-2-second UI latency.",
      "Automated case and audio extraction with a Playwright, Python and Vultr scraper, plus a custom Next.js spreadsheet app, removing 40 hours of admin work per week.",
    ],
  },
  {
    role: "Freelance Web Developer",
    org: "Remote",
    place: "US",
    period: "Jan 2023 — Present",
    points: [
      "Built an ecommerce site for Coway Viet with Next.js, Neon and TypeScript that drew thousands of visitors in its first year.",
      "Delivered 4sgtour, an international travel agency platform with i18n, Stripe payments and Twilio SMS — generating thousands of dollars in online sales.",
      "Created a Next.js and Puppeteer PDF tool for Smartrip.ai producing high-resolution itineraries under 20 MB.",
    ],
  },
  {
    role: "Software Developer Intern",
    org: "FarmSuite",
    place: "Stockton, CA",
    period: "Jan 2023 — Jun 2023",
    points: [
      "Designed 30+ interactive inventory and employee dashboards with Radzen and .NET.",
      "Integrated GPS mapping APIs for real-time tracking of 20+ assets at 500ms update latency.",
      "Rebuilt bulk inventory REST APIs, cutting processing from minutes to under 30 seconds.",
    ],
  },
  {
    role: "IT / Frontend Intern",
    org: "City of Stockton",
    place: "Stockton, CA",
    period: "Jan 2022 — Jul 2022",
    points: [
      "Built a cross-platform desktop utility in Electron, React and TypeScript that improved file management efficiency by 25%.",
      "Deployed standardized Windows images across 100+ workstations with a team of interns.",
    ],
  },
];
---

<Layout
  title="About"
  description="Andrew Bustos is a fullstack engineer at Interpret AI, based in Santa Clara, CA, with a BS in Computer Science from CSU East Bay. Experience across AI product engineering, Next.js web apps, React Native mobile and automation tooling.">
  <Container>
    <Sectionhead eyebrow="About">
      <Fragment slot="title">About Me</Fragment>
      <Fragment slot="desc">
        Experienced fullstack developer shipping products end to end.
      </Fragment>
    </Sectionhead>

    <div class="mx-auto mt-16 grid max-w-5xl gap-12 pb-24 lg:grid-cols-5">
      <div class="reveal lg:col-span-3">
        <h2
          class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl dark:text-white">
          I build the thing, ship it, and watch what it does.
        </h2>

        <div
          class="mt-6 flex flex-col gap-5 text-lg leading-relaxed text-stone-600 dark:text-stone-400">
          <p>
            I started teaching myself fullstack development in early 2021 with
            React and Express, went on to earn a BS in Computer Science from CSU
            East Bay, and have been working in the field since 2022. Today I'm a
            fullstack engineer at Interpret AI, building AI-powered translation
            and transcription products that people rely on in real time.
          </p>
          <p>
            What I like most is the unglamorous half of startup engineering: the
            scraper that reclaims 30 hours a week, the API that turns a
            minutes-long update into 30 seconds, the internal tool nobody demos
            but everybody uses. I work comfortably across the stack and lean on
            Claude Code as a force multiplier to move faster without cutting
            corners.
          </p>
          <p>
            My background: born in Hawaii, moved to different states and even
            lived in Germany at one point. I also like playing video games,
            especially PC games like World of Warcraft or Company of Heroes.
          </p>
        </div>

        <dl class="mt-10 grid gap-4 sm:grid-cols-3">
          {
            facts.map((fact, i) => (
              <div
                class="card-hover reveal rounded-2xl border border-stone-200 bg-white p-4 shadow-sm hover:border-brand-300 hover:shadow-lg dark:border-stone-800 dark:bg-stone-900/60 dark:hover:border-brand-700"
                style={`--reveal-delay:${i * 100}ms`}>
                <Icon
                  class="h-5 w-5 text-brand-600 dark:text-brand-400"
                  name={fact.icon}
                  aria-hidden="true"
                />
                <dt class="mt-3 text-xs uppercase tracking-widest text-stone-500 dark:text-stone-500">
                  {fact.label}
                </dt>
                <dd class="mt-1 font-semibold text-stone-900 dark:text-white">
                  {fact.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Link href="/projects">See my work</Link>
          <Link href="/contact" style="outline">Get in touch</Link>
        </div>
      </div>

      <!-- Portrait sits beside the intro (3 + 2 = the full 5-column row) -->
      <div class="reveal lg:col-span-2">
        <div class="group relative mx-auto max-w-sm">
          <div
            class="absolute -inset-3 rounded-3xl bg-gradient-to-tr from-brand-400/30 via-amber-400/20 to-transparent opacity-70 blur-2xl transition-opacity duration-500 group-hover:opacity-100"
            aria-hidden="true">
          </div>
          <Image
            src={heroImage}
            alt="Portrait of Andrew Bustos, fullstack engineer"
            sizes="(max-width: 1024px) 80vw, 400px"
            widths={[240, 400, 560]}
            fit="cover"
            position="center"
            class="relative w-full rounded-2xl object-cover shadow-2xl shadow-stone-900/25 ring-1 ring-stone-200 transition-transform duration-500 group-hover:-translate-y-1.5 dark:shadow-black/60 dark:ring-stone-800"
          />
        </div>
      </div>

      <!-- Experience timeline spans the full grid below the intro + photo -->
      <div class="lg:col-span-5">
        <h2
          class="reveal text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl dark:text-white">
          Experience
        </h2>

        <ol class="mt-8 space-y-5">
          {
            timeline.map((job, i) => (
              <li
                class="reveal card-hover relative overflow-hidden rounded-2xl border border-stone-200 bg-white p-6 shadow-sm hover:border-brand-300 hover:shadow-xl hover:shadow-brand-500/10 dark:border-stone-800 dark:bg-stone-900/60 dark:hover:border-brand-700"
                style={`--reveal-delay:${i * 90}ms`}>
                <span
                  class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-brand-500 to-amber-400"
                  aria-hidden="true"
                />

                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 pl-2">
                  <h3 class="text-lg font-semibold text-stone-900 dark:text-white">
                    {job.role}
                    <span class="text-brand-600 dark:text-brand-400">
                      {" · "}
                      {job.org}
                    </span>
                  </h3>
                  <p class="text-sm text-stone-500 dark:text-stone-500">
                    {job.period} · {job.place}
                  </p>
                </div>

                <ul class="mt-4 space-y-2.5 pl-2">
                  {job.points.map((point) => (
                    <li class="flex gap-3 text-stone-600 dark:text-stone-400">
                      <span
                        class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400"
                        aria-hidden="true"
                      />
                      <span class="leading-relaxed">{point}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Container>
</Layout>
