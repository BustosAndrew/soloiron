---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import ProjectsComponent from "@components/projects.astro";

const projects = [
  {
    name: "Markii",
    tech: "Supabase, Next.js, Typescript, Shadcn UI, Stripe",
    popular: false,
    features: [
      "Ecommerce Store Builder",
      "Stripe Payment Integration",
      "Customizable Themes",
      "Product Management",
    ],
    button: {
      text: "Build your ecommmerce store!",
      link: "https://markii-orcin.vercel.app/",
    },
  },
  {
    name: "Sendworth",
    tech: "Supabase, Next.js, Typescript, Shadcn UI, Redis",
    popular: true,
    features: [
      "Email & Domain Verification",
      "Spam and Scam Detection",
      "Customizable Email Templates",
      "Real-time Email Analytics",
    ],
    button: {
      text: "Block spam and scams!",
      link: "https://sendworth.dev/",
    },
  },
  {
    name: "LLMenu.ai",
    tech: "Supabase, Next.js, Typescript, Shadcn UI, Square API",
    popular: false,
    features: [
      "LLM txt file generation",
      "AI Traffic Analytics",
      "Square POS Integration",
      "AI Menu Suggestions",
    ],
    button: {
      text: "Scan your restaurant website!",
      link: "https://llmenu.ai/",
    },
  },
  {
    name: "Interpret.ai",
    tech: "Postgres, Python, React, Websockets, TypeScript",
    popular: true,
    features: [
      "Live Translation/Transcription",
      "Document management",
      "Live Broadcasting",
      "React Native mobile app",
    ],
    button: {
      text: "Translate with Interpret!",
      link: "https://interpretapp.ai/",
    },
  },
  {
    name: "4 Seasons Golf Tour",
    tech: "Supabase, Next.js, Typescript, Shadcn UI, Stripe",
    popular: false,
    features: [
      "Golf Trip Management",
      "Stripe Payment Integration",
      "Messaging System",
      "Twilio SMS Notifications",
    ],
    button: {
      text: "Book your next golf trip!",
      link: "https://4sgtour.com/",
    },
  },
  {
    name: "AI Assist",
    tech: "Go, Next.js, Twilio, Retell AI, Firebase",
    popular: true,
    features: [
      "AI IT Phone Support",
      "Conversational AI",
      "Active Call Logging",
      "Automated Ticket Creation",
      "Twilio Integration",
    ],
    button: {
      text: "Check out the Devpost",
      link: "https://devpost.com/software/it-assist",
    },
  },
  {
    name: "Rescue Ready VR",
    tech: "Unity, C#, Oculus Quest",
    popular: false,
    features: [
      "VR Evacuation Training",
      "Unity 3D Environment",
      "Oculus Quest Integration",
      "Realistic Fire Scenario",
    ],
    button: {
      text: "Check out the Devpost",
      link: "https://devpost.com/software/rescue-ready-vr",
    },
  },
  {
    name: "Docufiller AI",
    tech: "React, Python, OpenAI",
    popular: true,
    features: [
      "Automated Document Filling",
      "Click to drag interface",
      "File Management",
      "Custom Prompt Input",
    ],
    button: {
      text: "Check out the Devpost",
      link: "https://devpost.com/software/docufiller-ai",
    },
  },
  {
    name: "3Datalyze",
    tech: "Unity, C#, Oculus Quest",
    popular: false,
    features: [
      "3D Data Simulation",
      "Passthrough 3D Environment",
      "Oculus Quest Integration",
      "Realistic Data Visualization",
    ],
    button: {
      text: "Check out the Devpost",
      link: "https://devpost.com/software/table-61",
    },
  },
];
---

<Layout
  title="Projects"
  description="A portfolio of fullstack projects by Andrew Bustos — ecommerce store builders, AI tools, live translation platforms, VR training simulations, and more, built with Next.js, Supabase, TypeScript, Python and Unity.">
  <Container>
    <Sectionhead eyebrow="Portfolio">
      <Fragment slot="title">Projects</Fragment>
      <Fragment slot="desc">
        A selection of products, hackathon builds and client work — each one
        shipped end to end, from schema to interface.
      </Fragment>
    </Sectionhead>

    <div
      class="mx-auto mt-16 grid max-w-6xl grid-cols-1 gap-6 pb-24 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((item, index) => (
          <ProjectsComponent plan={item} index={index} />
        ))
      }
    </div>
  </Container>
</Layout>
