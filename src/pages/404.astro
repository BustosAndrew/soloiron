---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Link from "@components/ui/link.astro";
---

<Layout title="404 Not Found" description="This page could not be found." noindex>
  <Container>
    <div
      class="relative isolate flex min-h-[calc(100vh-22rem)] items-center justify-center py-20">
      <div
        class="glow-blob pointer-events-none absolute left-1/2 top-1/4 -z-10 h-64 w-[32rem] max-w-full -translate-x-1/2 rounded-full bg-brand-300/30 dark:bg-brand-600/15"
        aria-hidden="true">
      </div>

      <div class="animate-fade-up text-center">
        <p
          class="text-gradient text-7xl font-bold tracking-tighter sm:text-8xl lg:text-9xl">
          404
        </p>
        <h1
          class="mt-4 text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl dark:text-white">
          This page doesn't exist.
        </h1>
        <p
          class="mx-auto mt-3 max-w-md text-lg text-stone-600 dark:text-stone-400">
          The link may be broken or the page may have moved. Let's get you back
          on track.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <Link href="/">Back to home</Link>
          <Link href="/projects" style="outline">Browse projects</Link>
        </div>
      </div>
    </div>
  </Container>
</Layout>
