---
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Contactform from "@components/contactform.astro";

const details = [
  {
    icon: "uil:map-marker",
    label: "Location",
    value: "Santa Clara, CA",
  },
  {
    icon: "uil:clock",
    label: "Response time",
    value: "Usually within 1–2 days",
  },
  {
    icon: "bx:bxl-github",
    label: "GitHub",
    value: "@BustosAndrew",
    href: "https://github.com/BustosAndrew",
  },
];
---

<Layout
  title="Contact"
  description="Get in touch with Andrew Bustos, a fullstack engineer in Santa Clara, CA, about freelance projects, contract work, or full-time opportunities.">
  <Container>
    <Sectionhead eyebrow="Contact">
      <Fragment slot="title">Contact Me</Fragment>
      <Fragment slot="desc">
        Contact Andrew Bustos regarding potential projects or job opportunities.
      </Fragment>
    </Sectionhead>

    <div class="mx-auto mt-16 grid max-w-4xl gap-10 pb-24 md:grid-cols-2">
      <div class="reveal">
        <h2 class="text-2xl font-bold text-stone-900 dark:text-white">
          Let's build something.
        </h2>
        <p
          class="mt-3 text-lg leading-relaxed text-stone-600 dark:text-stone-400">
          Want to share your thoughts with me? I'm here to help. Fill out the
          form and I'll get back to you by email.
        </p>

        <dl class="mt-8 space-y-3">
          {
            details.map((detail) => (
              <div class="flex items-center gap-3 rounded-xl border border-stone-200 bg-white p-3.5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg dark:border-stone-800 dark:bg-stone-900/60 dark:hover:border-brand-700">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-400">
                  <Icon class="h-4 w-4" name={detail.icon} aria-hidden="true" />
                </span>
                <div>
                  <dt class="text-xs uppercase tracking-widest text-stone-500 dark:text-stone-500">
                    {detail.label}
                  </dt>
                  <dd class="font-medium text-stone-900 dark:text-white">
                    {detail.href ? (
                      <a
                        href={detail.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">
                        {detail.value}
                      </a>
                    ) : (
                      detail.value
                    )}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="reveal" style="--reveal-delay:120ms">
        <div
          class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xl shadow-stone-900/5 dark:border-stone-800 dark:bg-stone-900/60 dark:shadow-black/30">
          <Contactform />
        </div>
      </div>
    </div>
  </Container>
</Layout>
